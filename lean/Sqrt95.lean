lemma checkEdges_E : checkEdges 95 480 P E = true := by decide +kernel

lemma noLoops_E : noLoops E = true := by decide +kernel

/-- The colouring formula of the graph, with the edge `0–975` coloured `0, 1`. -/
def formula : List (List ℤ) := colourCNF E 0 975

