+import Mathlib
+
+/-! The countable plane used by the transfer: here the origami numbers, the smallest subfield `E` of `ℂ` closed
+under square roots and cube roots (it is closed under complex conjugation; Alperin, *A mathematical theory of
+origami constructions and numbers*, 2000, shows that these are the points constructible by paper folding), and its
+real points `F`. The rest of the proof uses only the facts proved in this file. -/
+
+namespace OAI
+
+noncomputable section
+open scoped ComplexConjugate
+namespace PlaneFiveColor.Spectral
+
+/-- Closure under square roots and cube roots. -/
+def RootClosed (s : IntermediateField ℚ ℂ) : Prop :=
+  (∀ x : ℂ, x ^ 2 ∈ s → x ∈ s) ∧ (∀ x : ℂ, x ^ 3 ∈ s → x ∈ s)
+
+abbrev E : IntermediateField ℚ ℂ := sInf {s | RootClosed s}
+
+theorem E_le {s : IntermediateField ℚ ℂ} (h : RootClosed s) : E ≤ s := sInf_le h
+
+theorem E_sqrt_mem {x : ℂ} (hx : x ^ 2 ∈ E) : x ∈ E := by
+  rw [IntermediateField.mem_sInf] at hx ⊢
+  intro s hs
+  exact hs.1 x (hx s hs)
+
+theorem E_cbrt_mem {x : ℂ} (hx : x ^ 3 ∈ E) : x ∈ E := by
+  rw [IntermediateField.mem_sInf] at hx ⊢
+  intro s hs
+  exact hs.2 x (hx s hs)
+
+/-- Roots of every order `2^a 3^b`. -/
+theorem E_root_mem {x : ℂ} (a b : ℕ) (hx : x ^ (2 ^ a * 3 ^ b) ∈ E) : x ∈ E := by
+  induction a generalizing x with
+  | zero =>
+    induction b generalizing x with
+    | zero => simpa using hx
+    | succ b ih =>
+      apply ih
+      apply E_cbrt_mem
+      rw [← pow_mul]
+      simpa [pow_succ, mul_comm, mul_assoc, mul_left_comm] using hx
+  | succ a ih =>
+    apply ih
+    apply E_sqrt_mem
+    rw [← pow_mul]
+    simpa [pow_succ, mul_comm, mul_assoc, mul_left_comm] using hx
+
+theorem E_isAlgebraic {x : ℂ} (hx : x ∈ E) : IsAlgebraic ℚ x := by
+  have h : E ≤ solvableByRad ℚ ℂ :=
+    E_le ⟨fun y hy => solvableByRad.rad_mem two_ne_zero hy,
+      fun y hy => solvableByRad.rad_mem three_ne_zero hy⟩
+  exact mem_algebraicClosure_iff.mp (solvableByRad_le_algClosure ℚ ℂ (h hx))
+
+theorem E_conj_mem {x : ℂ} (hx : x ∈ E) : conj x ∈ E := by
+  let c : ℂ →ₐ[ℚ] ℂ := (Complex.conjAe.restrictScalars ℚ).toAlgHom
+  have h : E ≤ E.comap c := by
+    apply E_le
+    constructor
+    · intro y hy
+      change c y ∈ E
+      have hy' : c (y ^ 2) ∈ E := hy
+      rw [map_pow] at hy'
+      exact E_sqrt_mem hy'
+    · intro y hy
+      change c y ∈ E
+      have hy' : c (y ^ 3) ∈ E := hy
+      rw [map_pow] at hy'
+      exact E_cbrt_mem hy'
+  exact h hx
+
+theorem E_I_mem : Complex.I ∈ E :=
+  E_sqrt_mem (by rw [Complex.I_sq]; exact neg_mem (one_mem _))
+
+theorem E_two_mem : (2 : ℂ) ∈ E := by exact_mod_cast E.natCast_mem 2
+
+theorem E_ofReal_re_mem {z : ℂ} (hz : z ∈ E) : ((z.re : ℝ) : ℂ) ∈ E := by
+  have h : ((z.re : ℝ) : ℂ) = (z + conj z) * (2 : ℂ)⁻¹ := by
+    apply Complex.ext <;> simp <;> ring
+  rw [h]
+  exact mul_mem (add_mem hz (E_conj_mem hz)) (inv_mem E_two_mem)
+
+theorem E_ofReal_im_mem {z : ℂ} (hz : z ∈ E) : ((z.im : ℝ) : ℂ) ∈ E := by
+  have h : ((z.im : ℝ) : ℂ) = (z - conj z) * ((2 : ℂ) * Complex.I)⁻¹ := by
+    apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im, Complex.inv_re, Complex.inv_im] <;> ring
+  rw [h]
+  exact mul_mem (sub_mem hz (E_conj_mem hz)) (inv_mem (mul_mem E_two_mem E_I_mem))
+
+theorem E_ofReal_norm_mem {z : ℂ} (hz : z ∈ E) : ((‖z‖ : ℝ) : ℂ) ∈ E := by
+  apply E_sqrt_mem
+  have h : (((‖z‖ : ℝ) : ℂ)) ^ 2 = z * conj z := by
+    rw [Complex.mul_conj, ← Complex.ofReal_pow, Complex.sq_norm]
+  rw [h]
+  exact mul_mem hz (E_conj_mem hz)
+
+/-- The real points of `E`. -/
+abbrev F : IntermediateField ℚ ℝ := E.comap ((Complex.ofRealAm).restrictScalars ℚ)
+
+theorem mem_F_iff {t : ℝ} : t ∈ F ↔ (t : ℂ) ∈ E := Iff.rfl
+
+theorem F_rat_mem (q : ℚ) : (q : ℝ) ∈ F := by
+  rw [mem_F_iff]; push_cast; exact E.algebraMap_mem q
+
+theorem F_isAlgebraic {t : ℝ} (ht : t ∈ F) : IsAlgebraic ℚ t :=
+  (isAlgebraic_algebraMap_iff (R := ℚ) (S := ℝ) (A := ℂ) Complex.ofReal_injective).mp
+    (E_isAlgebraic (mem_F_iff.mp ht))
+
+theorem F_sqrt_mem {t : ℝ} (ht : t ∈ F) (h0 : 0 ≤ t) : Real.sqrt t ∈ F := by
+  rw [mem_F_iff]
+  apply E_sqrt_mem
+  rw [← Complex.ofReal_pow, Real.sq_sqrt h0]
+  exact mem_F_iff.mp ht
+
+theorem F_re_mem {z : ℂ} (hz : z ∈ E) : z.re ∈ F := E_ofReal_re_mem hz
+theorem F_im_mem {z : ℂ} (hz : z ∈ E) : z.im ∈ F := E_ofReal_im_mem hz
+theorem F_norm_mem {z : ℂ} (hz : z ∈ E) : ‖z‖ ∈ F := E_ofReal_norm_mem hz
+
+end PlaneFiveColor.Spectral
+end
+end OAI
