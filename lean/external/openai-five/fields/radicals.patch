+import Mathlib
+
+/-! The countable plane used by the transfer: here the numbers expressible by radicals, `E = solvableByRad ℚ ℂ`
+(the smallest subfield of `ℂ` closed under `n`-th roots), and its real points `F`. The rest of the proof uses only
+the facts proved in this file. -/
+
+namespace OAI
+
+noncomputable section
+open scoped ComplexConjugate
+namespace PlaneFiveColor.Spectral
+
+abbrev E : IntermediateField ℚ ℂ := solvableByRad ℚ ℂ
+
+theorem E_rad_mem {x : ℂ} {n : ℕ} (hn : n ≠ 0) (hx : x ^ n ∈ E) : x ∈ E :=
+  solvableByRad.rad_mem hn hx
+
+theorem E_isAlgebraic {x : ℂ} (hx : x ∈ E) : IsAlgebraic ℚ x :=
+  mem_algebraicClosure_iff.mp (solvableByRad_le_algClosure ℚ ℂ hx)
+
+theorem E_conj_mem {x : ℂ} (hx : x ∈ E) : conj x ∈ E := by
+  let c : ℂ →ₐ[ℚ] ℂ := (Complex.conjAe.restrictScalars ℚ).toAlgHom
+  have h : E ≤ E.comap c := by
+    apply solvableByRad_le
+    intro y n hn hy
+    change c y ∈ E
+    have hy' : c (y ^ n) ∈ E := hy
+    rw [map_pow] at hy'
+    exact E_rad_mem hn hy'
+  exact h hx
+
+theorem E_I_mem : Complex.I ∈ E :=
+  E_rad_mem (n := 2) two_ne_zero (by rw [Complex.I_sq]; exact neg_mem (one_mem _))
+
+theorem E_two_mem : (2 : ℂ) ∈ E := by exact_mod_cast E.natCast_mem 2
+
+theorem E_ofReal_re_mem {z : ℂ} (hz : z ∈ E) : ((z.re : ℝ) : ℂ) ∈ E := by
+  have h : ((z.re : ℝ) : ℂ) = (z + conj z) * (2 : ℂ)⁻¹ := by
+    apply Complex.ext <;> simp <;> ring
+  rw [h]
+  exact mul_mem (add_mem hz (E_conj_mem hz)) (inv_mem E_two_mem)
+
+theorem E_ofReal_im_mem {z : ℂ} (hz : z ∈ E) : ((z.im : ℝ) : ℂ) ∈ E := by
+  have h : ((z.im : ℝ) : ℂ) = (z - conj z) * ((2 : ℂ) * Complex.I)⁻¹ := by
+    apply Complex.ext <;> simp [Complex.mul_re, Complex.mul_im, Complex.inv_re, Complex.inv_im] <;> ring
+  rw [h]
+  exact mul_mem (sub_mem hz (E_conj_mem hz)) (inv_mem (mul_mem E_two_mem E_I_mem))
+
+theorem E_ofReal_norm_mem {z : ℂ} (hz : z ∈ E) : ((‖z‖ : ℝ) : ℂ) ∈ E := by
+  apply E_rad_mem (n := 2) two_ne_zero
+  have h : (((‖z‖ : ℝ) : ℂ)) ^ 2 = z * conj z := by
+    rw [Complex.mul_conj, ← Complex.ofReal_pow, Complex.sq_norm]
+  rw [h]
+  exact mul_mem hz (E_conj_mem hz)
+
+/-- The real points of `E`. -/
+abbrev F : IntermediateField ℚ ℝ := E.comap ((Complex.ofRealAm).restrictScalars ℚ)
+
+theorem mem_F_iff {t : ℝ} : t ∈ F ↔ (t : ℂ) ∈ E := Iff.rfl
+
+theorem F_rat_mem (q : ℚ) : (q : ℝ) ∈ F := by
+  rw [mem_F_iff]; push_cast; exact E.algebraMap_mem q
+
+theorem F_isAlgebraic {t : ℝ} (ht : t ∈ F) : IsAlgebraic ℚ t :=
+  (isAlgebraic_algebraMap_iff (R := ℚ) (S := ℝ) (A := ℂ) Complex.ofReal_injective).mp
+    (E_isAlgebraic (mem_F_iff.mp ht))
+
+theorem F_sqrt_mem {t : ℝ} (ht : t ∈ F) (h0 : 0 ≤ t) : Real.sqrt t ∈ F := by
+  rw [mem_F_iff]
+  apply E_rad_mem (n := 2) two_ne_zero
+  rw [← Complex.ofReal_pow, Real.sq_sqrt h0]
+  exact mem_F_iff.mp ht
+
+theorem F_re_mem {z : ℂ} (hz : z ∈ E) : z.re ∈ F := E_ofReal_re_mem hz
+theorem F_im_mem {z : ℂ} (hz : z ∈ E) : z.im ∈ F := E_ofReal_im_mem hz
+theorem F_norm_mem {z : ℂ} (hz : z ∈ E) : ‖z‖ ∈ F := E_ofReal_norm_mem hz
+
+end PlaneFiveColor.Spectral
+end
+end OAI
