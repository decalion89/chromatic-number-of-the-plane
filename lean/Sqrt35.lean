/-- Edges 1500 to 1500 of `data/quadratic_planes/q35.json`. -/
def E3 : List (Fin 580 × Fin 580) := [
    (534, 578)]

/-- The 1501 edges of `data/quadratic_planes/q35.json`: all the unit distances among the points. -/
def E : List (Fin 580 × Fin 580) :=
  E0 ++ (E1 ++ (E2 ++ (E3)))

lemma checkEdges_E : checkEdges 35 390 P E = true := by decide +kernel

lemma noLoops_E : noLoops E = true := by decide +kernel

/-- The colouring formula of the graph, with the edge `0–10` coloured `0, 1`. -/
def formula : List (List ℤ) := colourCNF E 0 10

-- `q35.cnf` is `formula`.
#guard parseDimacs (include_str "../data/quadratic_planes/q35.cnf") == formula

/-- **Lower bound**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√35)²` is not 3-colourable. -/
theorem not_colorable_three_of_unsatisfiable (h : Unsatisfiable formula) :
    ¬(unitDistGraph (L 35)).Colorable 3 := fun hc =>
  not_colorable_of_unsatisfiable noLoops_E (List.mem_append_left _ (List.mem_cons_self ..)) h
    (hc.of_hom (edgeGraph.hom (fun i => pt 35 390 (P i)) (pt_adj (by norm_num) checkEdges_E)))

/-- **Theorem**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√35)²` has chromatic number 4. -/
theorem chromaticNumber_eq_four_of_unsatisfiable (h : Unsatisfiable formula) :
    (unitDistGraph (L 35)).chromaticNumber = 4 :=
  chromaticNumber_eq_four_of (colorable_four_ramified (d' := 5) (by norm_num) (by norm_num))
    (not_colorable_three_of_unsatisfiable h)

end Sqrt35
