  E0 ++ (E1 ++ (E2))

lemma checkEdges_E : checkEdges 851 2460 P E = true := by decide +kernel

lemma noLoops_E : noLoops E = true := by decide +kernel

/-- The colouring formula of the graph, with the edge `0–274` coloured `0, 1`. -/
