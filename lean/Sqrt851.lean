/-- **Lower bound**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√851)²` is not 3-colourable. -/
theorem not_colorable_three_of_unsatisfiable (h : Unsatisfiable formula) :
    ¬(unitDistGraph (L 851)).Colorable 3 := fun hc =>
  not_colorable_of_unsatisfiable noLoops_E (List.mem_append_left _ (List.mem_cons_self ..)) h
    (hc.of_hom (edgeGraph.hom (fun i => pt 851 2460 (P i)) (pt_adj (by norm_num) checkEdges_E)))

/-- **Theorem**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√851)²` has chromatic number 4. -/
theorem chromaticNumber_eq_four_of_unsatisfiable (h : Unsatisfiable formula) :
    (unitDistGraph (L 851)).chromaticNumber = 4 :=
  chromaticNumber_eq_four_of (colorable_four (s := 2) (by norm_num) (by norm_num))
    (not_colorable_three_of_unsatisfiable h)

