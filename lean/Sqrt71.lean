def E : List (Fin 611 × Fin 611) :=
  E0 ++ (E1 ++ (E2 ++ (E3)))

lemma checkEdges_E : checkEdges 71 120 P E = true := by decide +kernel

lemma noLoops_E : noLoops E = true := by decide +kernel

/-- The colouring formula of the graph, with the edge `0–17` coloured `0, 1`. -/
def formula : List (List ℤ) := colourCNF E 0 17

-- `q71.cnf` is `formula`.
#guard parseDimacs (include_str "../data/quadratic_planes/q71.cnf") == formula

/-- **Lower bound**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√71)²` is not 3-colourable. -/
theorem not_colorable_three_of_unsatisfiable (h : Unsatisfiable formula) :
    ¬(unitDistGraph (L 71)).Colorable 3 := fun hc =>
  not_colorable_of_unsatisfiable noLoops_E (List.mem_append_left _ (List.mem_cons_self ..)) h
    (hc.of_hom (edgeGraph.hom (fun i => pt 71 120 (P i)) (pt_adj (by norm_num) checkEdges_E)))

/-- **Theorem**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√71)²` has chromatic number 4. -/
theorem chromaticNumber_eq_four_of_unsatisfiable (h : Unsatisfiable formula) :
    (unitDistGraph (L 71)).chromaticNumber = 4 :=
  chromaticNumber_eq_four_of (colorable_four (s := 1) (by norm_num) (by norm_num))
    (not_colorable_three_of_unsatisfiable h)

