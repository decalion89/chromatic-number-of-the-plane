/-- **Lower bound.** The unit-distance graph of `ℚ(√11)²` is not 3-colourable. -/
theorem not_colorable_three : ¬ (unitDistGraph (L 11)).Colorable 3 := fun h =>
  graph_not_colorable (h.of_hom (edgeGraph.hom (fun i => pt 11 30 (P i)) (pt_adj (by norm_num) checkEdges_E)))

/-- **Theorem.** The unit-distance graph of `ℚ(√11)²` has chromatic number 4. -/
