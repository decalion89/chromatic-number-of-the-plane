/-- **Theorem**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√263)²` has chromatic number 4. -/
theorem chromaticNumber_eq_four_of_unsatisfiable (h : Unsatisfiable formula) :
    (unitDistGraph (L 263)).chromaticNumber = 4 :=
  chromaticNumber_eq_four_of (colorable_four (s := 2) (by norm_num) (by norm_num))
    (not_colorable_three_of_unsatisfiable h)

