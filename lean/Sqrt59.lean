/-- The 993 edges of `data/quadratic_planes/q59.json`: all the unit distances among the points. -/
def E : List (Fin 406 × Fin 406) :=
  E0 ++ (E1)

lemma checkEdges_E : checkEdges 59 210 P E = true := by decide +kernel

lemma noLoops_E : noLoops E = true := by decide +kernel

/-- The colouring formula of the graph, with the edge `0–2` coloured `0, 1`. -/
def formula : List (List ℤ) := colourCNF E 0 2

-- `q59.cnf` is `formula`.
#guard parseDimacs (include_str "../data/quadratic_planes/q59.cnf") == formula

/-- **Lower bound**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√59)²` is not 3-colourable. -/
theorem not_colorable_three_of_unsatisfiable (h : Unsatisfiable formula) :
    ¬(unitDistGraph (L 59)).Colorable 3 := fun hc =>
  not_colorable_of_unsatisfiable noLoops_E (List.mem_append_left _ (List.mem_cons_self ..)) h
    (hc.of_hom (edgeGraph.hom (fun i => pt 59 210 (P i)) (pt_adj (by norm_num) checkEdges_E)))

/-- **Theorem**, if `formula` is unsatisfiable: the unit-distance graph of `ℚ(√59)²` has chromatic number 4. -/
theorem chromaticNumber_eq_four_of_unsatisfiable (h : Unsatisfiable formula) :
    (unitDistGraph (L 59)).chromaticNumber = 4 :=
  chromaticNumber_eq_four_of (colorable_four_two (by norm_num))
    (not_colorable_three_of_unsatisfiable h)

